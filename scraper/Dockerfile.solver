# Cloudflare solver: cf-clearance-scraper + Chromium on a virtual display (no screen needed).
# Built from tools/cf-clearance-scraper with locked dependency versions (npm ci).
FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
      chromium xvfb xauth ca-certificates fonts-liberation \
 && rm -rf /var/lib/apt/lists/*
ENV CHROME_BIN=/usr/bin/chromium CHROME_PATH=/usr/bin/chromium
WORKDIR /app
COPY package*.json ./
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund
COPY src ./src
ENV PORT=3000
EXPOSE 3000
CMD ["node", "src/index.js"]
