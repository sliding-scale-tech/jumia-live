# Copy to .env on the server:  cp .env.example .env
# Long random secret shared with the website (its SCRAPER_API_KEY). Generate: openssl rand -hex 32
API_KEY=change-me
# Optional proxy for every request to Jumia, incl. the Cloudflare solver. Format: http://user:password@host:port
# (Cloudflare ties its cookie to the IP, so the same proxy is used for both. Changing it triggers a fresh solve.)
PROXY_URL=
# Domain whose DNS A record points at this server, e.g. api.yourdomain.com
API_DOMAIN=api.example.com
